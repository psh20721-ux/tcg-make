# Copy this file to .env.local. Never put a key in public/ or commit the file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_ENABLED=true
# Optional exact origin, e.g. https://your-project.vercel.app (no trailing slash).
# Leave blank to require the request Origin host to match the request Host.
ALLOWED_ORIGIN=
